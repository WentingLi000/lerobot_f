{
  "job_name": "pi05_scarf_pGbs16_10k_accu_4_t1",
  "output_dir": "outputs/train/pi05_scarf_pGbs16_10k_accum_4_t1",

  "dataset": {
    "repo_id": "ZhuoyueLLL/new_scarf_25hz_right_wrist",
