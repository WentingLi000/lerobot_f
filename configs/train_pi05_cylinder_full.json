{
  "job_name": "pi05_cylinder_full",
  "output_dir": "outputs/train/pi05_cylinder_full",
  "dataset": {
    "repo_id": "Danny1124/cylinder_full",
    "root": "/hkfs/work/workspace/scratch/ujzmd-lerobot/cylinder_full",
    "return_uint8": true,
    "streaming": false,
    "use_imagenet_stats": true,
    "video_backend": "torchcodec"
  },
  "policy": {
    "type": "pi05",
    "pretrained_path": "/hkfs/work/workspace/scratch/ujzmd-lerobot/hf_cache/models/lerobot/pi05_base",
    "push_to_hub": false,
    "device": "cuda",
    "dtype": "bfloat16",
    "use_amp": true,
    "gradient_checkpointing": true,
    "compile_model": false,
    "train_expert_only": false,
    "freeze_vision_encoder": false,
    "input_features": {
      "observation.state": {
        "type": "STATE",
        "shape": [8]
      },
      "observation.images.wrist_cam": {
        "type": "VISUAL",
        "shape": [3, 224, 224]
      },
      "observation.images.opst_cam": {
        "type": "VISUAL",
        "shape": [3, 224, 224]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [8]
      }
    },
    "optimizer_lr": 5e-05,
    "optimizer_betas": [0.9, 0.95],
    "optimizer_eps": 1e-08,
    "optimizer_weight_decay": 0.01,
    "optimizer_grad_clip_norm": 1.0,
    "scheduler_warmup_steps": 1000,
    "scheduler_decay_steps": 10000,
    "scheduler_decay_lr": 2.5e-06
  },
  "rename_map": {
    "observation.images.static_cam": "observation.images.opst_cam"
  },
  "batch_size": 8,
  "gradient_accumulation_steps": 4,
  "steps": 10000,
  "num_workers": 2,
  "persistent_workers": true,
  "log_freq": 10,
  "save_checkpoint": true,
  "save_freq": 2500,
  "eval_freq": 200000,
  "wandb": {
    "enable": true,
    "mode": "online",
    "project": "lerobot_pi05",
    "entity": "wentingli-kit",
    "disable_artifact": true
  }
}
